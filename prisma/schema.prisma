  CANDIDATE_CREATED
  CANDIDATE_PROFILE_UPDATED
  CANDIDATE_EXPERIENCE_UPDATED
  CANDIDATE_EDUCATION_UPDATED
  CANDIDATE_SKILLS_UPDATED
  CANDIDATE_DOCUMENT_UPLOADED
  CANDIDATE_DOCUMENT_VIEWED
  CANDIDATE_DOCUMENT_DELETED
  SECURITY_ALERT_INVALID_STORAGE_PATH
