/// Phase 6C — append-only external outcome ledger (not ApplicationStatus).
model ApplicationOutcomeEvent {
  id                  String                            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId      String                            @db.Uuid
  applicationId       String                            @db.Uuid
  outcomeType         ApplicationOutcomeType
  provenance          ApplicationOutcomeProvenance
  actorUserId         String                            @db.Uuid
  recordedAt          DateTime                          @default(now()) @db.Timestamptz(6)
  occurredAt          DateTime?                         @db.Timestamptz(6)
  notes               String?                           @db.Text
  /// O3: OTHER defaults false; other types typically true for staff-recorded/verified.
  candidateVisible    Boolean                           @default(false)
  evidenceText        String?                           @db.Text
  evidenceStoragePath String?                           @db.VarChar(1024)
  /// When true, candidate may request a signed download for evidence (staff-gated share).
  evidenceShareable   Boolean                           @default(false)
  correctionState     ApplicationOutcomeCorrectionState @default(ACTIVE)
  voidedAt            DateTime?                         @db.Timestamptz(6)
  voidedById          String?                           @db.Uuid
  voidReason          String?                           @db.Text
  supersededById      String?                           @db.Uuid
  createdAt           DateTime                          @default(now()) @db.Timestamptz(6)

  organization Organization              @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  application  Application               @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  actor        User                      @relation("OutcomeActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  voidedBy     User?                     @relation("OutcomeVoider", fields: [voidedById], references: [id], onDelete: SetNull)
  supersededBy ApplicationOutcomeEvent?  @relation("OutcomeSupersession", fields: [supersededById], references: [id], onDelete: SetNull)
  supersedes   ApplicationOutcomeEvent[] @relation("OutcomeSupersession")

  @@index([organizationId, applicationId, recordedAt])
  @@index([applicationId, correctionState, recordedAt])
  @@index([organizationId, outcomeType, recordedAt])
  @@map("application_outcome_events")
}

