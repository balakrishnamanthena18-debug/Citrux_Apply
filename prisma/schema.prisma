  APPLICATION_INTELLIGENCE_REQUESTED
  APPLICATION_INTELLIGENCE_STARTED
  APPLICATION_INTELLIGENCE_COMPLETED
  APPLICATION_INTELLIGENCE_FAILED
  APPLICATION_INTELLIGENCE_INVALIDATED
