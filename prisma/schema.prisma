enum DesignationStatus {
  ACTIVE
  ARCHIVED
}

enum PrivacyRequestType {
  DATA_EXPORT
  DATA_CORRECTION
  DATA_DELETION
}

enum PrivacyRequestStatus {
  PENDING
  IDENTITY_VERIFIED
  IN_REVIEW
  COMPLETED
  REJECTED
}

model Organization {
  id        String             @id @default(uuid()) @db.Uuid
  name      String             @db.VarChar(255)
  slug      String             @unique @db.VarChar(100)
  status    OrganizationStatus @default(ACTIVE)
  createdAt DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt DateTime           @updatedAt @db.Timestamptz(6)

  memberships                 Membership[]
  designations                Designation[]
  staffActivationTokens       StaffActivationToken[]
  auditEvents                 AuditEvent[]
  candidates                  Candidate[]
  jobs                        Job[]
  candidateJobOpportunities   CandidateJobOpportunity[]
  applications                Application[]
  tasks                       Task[]
  taskGovernancePolicy        TaskGovernancePolicy?
  qaReviews                   ApplicationQaReview[]
  conversations               Conversation[]
  internalNotes               InternalNote[]
  notifications               Notification[]
  emailDeliveryLogs           EmailDeliveryLog[]
  privacyRequests             PrivacyRequest[]
  jobDescriptionSnapshots     JobDescriptionSnapshot[]
  jobRequirementSets          JobRequirementSet[]
  applicationIntelligenceRuns ApplicationIntelligenceRun[]
  applicationAlignmentResults ApplicationAlignmentResult[]
  applicationReadinessResults ApplicationReadinessResult[]
  candidateFactAttestations   CandidateFactAttestation[]
  candidateDocumentExtracts   CandidateDocumentExtract[]
  resumeReviews               ResumeReview[]
  candidateJobMatches         CandidateJobMatch[]
  applicationOutcomeEvents    ApplicationOutcomeEvent[]
  interviews                  Interview[]
  interviewRounds             InterviewRound[]
  interviewDebriefs           InterviewDebrief[]
  offers                      Offer[]
  offerVersions               OfferVersion[]
  negotiations                Negotiation[]
  negotiationEvents           NegotiationEvent[]
  offerDecisions              OfferDecision[]
  joiningRecords              JoiningRecord[]
  placementRecords            PlacementRecord[]
  offerEvidence               OfferEvidence[]

  // Phase 10 CBOS Relations
  customerAccounts               CustomerAccount[]
  customerCandidateRelationships CustomerCandidateRelationship[]
  serviceContracts               ServiceContract[]
  serviceContractVersions        ServiceContractVersion[]
  serviceEntitlements            ServiceEntitlement[]
  pricingTerms                   PricingTerm[]
  commercialEvents               CommercialEvent[]
  cbosOutboxEvents               CbosOutboxEvent[]
  invoices                       Invoice[]
  invoiceLines                   InvoiceLine[]
  payments                       Payment[]
  commercialCredits              CommercialCredit[]
  commercialRefunds              CommercialRefund[]
  commercialAdjustments          CommercialAdjustment[]
  revenueAttributions            RevenueAttribution[]

  // Phase 10H WCOS Relations
  wcosQueues                WcosQueue[]
  wcosSlaPolicies           WcosSlaPolicy[]
  wcosCapacityPolicies      WcosCapacityPolicy[]
  wcosCapacityProfiles      WcosCapacityProfile[]
  wcosAvailabilityRecords   WcosAvailabilityRecord[]
  wcosCapabilityDefinitions WcosCapabilityDefinition[]
  wcosEmployeeCapabilities  WcosEmployeeCapability[]
  wcosWorkItems             WcosWorkItem[]
  wcosCapacityReservations  WcosCapacityReservation[]
  wcosAssignmentHistories   WcosAssignmentHistory[]
  wcosDispatchDecisions     WcosDispatchDecision[]
  wcosBlockingRecords       WcosBlockingRecord[]
  wcosEscalationRecords     WcosEscalationRecord[]

  @@map("organizations")
}

model TaskGovernancePolicy {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String   @unique @map("organization_id") @db.Uuid
  canCreateRoles   Json     @default("[\"ADMIN\", \"MANAGER\", \"TEAM_LEAD\"]") @map("can_create_roles") @db.JsonB
  canAssignRoles   Json     @default("[\"ADMIN\", \"MANAGER\", \"TEAM_LEAD\"]") @map("can_assign_roles") @db.JsonB
  canCancelRoles   Json     @default("[\"ADMIN\", \"MANAGER\", \"TEAM_LEAD\"]") @map("can_cancel_roles") @db.JsonB
  canEscalateRoles Json     @default("[\"ADMIN\", \"MANAGER\", \"TEAM_LEAD\"]") @map("can_escalate_roles") @db.JsonB
  canCompleteRoles Json     @default("[\"ADMIN\", \"MANAGER\", \"TEAM_LEAD\", \"EMPLOYEE\"]") @map("can_complete_roles") @db.JsonB
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId], name: "idx_task_governance_org")
  @@map("task_governance_policies")
}

model User {
  id        String     @id @db.Uuid // Matches Supabase auth.users.id
  email     String     @unique @db.VarChar(255)
  firstName String?    @db.VarChar(100)
  lastName  String?    @db.VarChar(100)
  status    UserStatus @default(ACTIVE)
  createdAt DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt DateTime   @updatedAt @db.Timestamptz(6)

  memberships                   Membership[]
  subordinates                  Membership[]                 @relation("ReportingManager")
  auditEvents                   AuditEvent[]                 @relation("ActorAuditEvents")
  candidate                     Candidate?
  assignedCandidates            Candidate[]                  @relation("AssignedCandidateEmployee")
  verifiedCandidates            Candidate[]                  @relation("CandidateVerifier")
  uploadedDocuments             CandidateDocument[]          @relation("DocumentUploader")
  createdJobs                   Job[]                        @relation("JobCreator")
  discoveredJobOpportunities    CandidateJobOpportunity[]    @relation("OpportunityDiscoverer")
  assignedApplications          Application[]                @relation("ApplicationAssignee")
  assignmentManagerApplications Application[]                @relation("ApplicationAssignedManager")
  approvedApplications          Application[]                @relation("ApplicationApprover")
  createdMaterials              ApplicationMaterial[]        @relation("MaterialCreator")
  submittedApps                 ApplicationSubmission[]      @relation("AppSubmissions")
  stateHistoryChanges           ApplicationStateHistory[]    @relation("StateHistoryChanger")
  assignedTasks                 Task[]                       @relation("TaskAssignee")
  completedTasks                Task[]                       @relation("TaskCompleter")
  createdTasks                  Task[]                       @relation("TaskCreator")
  completedChecklistItems       TaskChecklistItem[]          @relation("ChecklistItemCompleter")
  changedTaskStateHistories     TaskStateHistory[]           @relation("TaskStateChanger")
  qaReviews                     ApplicationQaReview[]        @relation("QaReviewer")
  sentMessages                  Message[]                    @relation("MessageSender")
  authoredNotes                 InternalNote[]               @relation("NoteAuthor")
  receivedNotifications         Notification[]               @relation("NotificationRecipient")
  privacyRequestsSubmitted      PrivacyRequest[]             @relation("PrivacyRequestedBy")
  privacyRequestsVerified       PrivacyRequest[]             @relation("PrivacyVerifiedBy")
  privacyRequestsCompleted      PrivacyRequest[]             @relation("PrivacyCompletedBy")
  intelligenceRunsRequested     ApplicationIntelligenceRun[] @relation("IntelligenceRunRequester")
  factAttestationsAuthored      CandidateFactAttestation[]   @relation("FactAttestationAuthor")
  resumeReviewsRequested        ResumeReview[]               @relation("ResumeReviewRequester")
  jobMatchesRequested           CandidateJobMatch[]          @relation("JobMatchRequester")
  applicationOutcomesActed      ApplicationOutcomeEvent[]    @relation("OutcomeActor")
  applicationOutcomesVoided     ApplicationOutcomeEvent[]    @relation("OutcomeVoider")
  voidedRounds                  InterviewRound[]             @relation("RoundVoider")
  submittedDebriefs             InterviewDebrief[]           @relation("DebriefSubmitter")
  verifiedOffers                Offer[]                      @relation("OfferVerifier")
  voidedOffers                  Offer[]                      @relation("OfferVoider")
  negotiationEventsAuthored     NegotiationEvent[]           @relation("NegotiationEventActor")
  offerDecisionsAuthored        OfferDecision[]              @relation("OfferDecisionActor")
  verifiedPlacements            PlacementRecord[]            @relation("PlacementVerifier")
  voidedPlacements              PlacementRecord[]            @relation("PlacementVoider")
  uploadedOfferEvidence         OfferEvidence[]              @relation("OfferEvidenceUploader")

  // Phase 10 CBOS User Relations
  createdContractVersions ServiceContractVersion[] @relation("ContractVersionCreator")
  recordedPayments        Payment[]                @relation("PaymentRecorder")
  issuedCredits           CommercialCredit[]       @relation("CreditIssuer")
  authorizedRefunds       CommercialRefund[]       @relation("RefundAuthorizer")
  authorizedAdjustments   CommercialAdjustment[]   @relation("AdjustmentAuthorizer")
  strategistAttributions  RevenueAttribution[]     @relation("AttributedStrategist")
  specialistAttributions  RevenueAttribution[]     @relation("AttributedSpecialist")
  sourcingAttributions    RevenueAttribution[]     @relation("AttributedSourcing")

  // Phase 10H WCOS User Relations
  wcosCapacityProfiles            WcosCapacityProfile[]
  wcosAvailabilityRecords         WcosAvailabilityRecord[]  @relation("WcosEmployeeAvailability")
  wcosAuthoredAvailabilityRecords WcosAvailabilityRecord[]  @relation("WcosAvailabilityActor")
  wcosEmployeeCapabilities        WcosEmployeeCapability[]  @relation("WcosEmployeeCapabilities")
  wcosVerifiedCapabilities        WcosEmployeeCapability[]  @relation("WcosCapabilityVerifier")
  wcosCapacityReservations        WcosCapacityReservation[]
  wcosAssignedHistories           WcosAssignmentHistory[]   @relation("WcosNewEmployeeHistory")
  wcosPreviousHistories           WcosAssignmentHistory[]   @relation("WcosPreviousEmployeeHistory")
  wcosAuthoredHistories           WcosAssignmentHistory[]   @relation("WcosAssignmentActor")
  wcosSelectedDecisions           WcosDispatchDecision[]    @relation("WcosSelectedEmployeeDecision")
  wcosAuthoredDecisions           WcosDispatchDecision[]    @relation("WcosDispatchActor")
  wcosAuthoredBlockingRecords     WcosBlockingRecord[]      @relation("WcosBlockingActor")
  wcosUnblockActorRecords         WcosBlockingRecord[]      @relation("WcosUnblockActor")
  wcosAuthoredEscalations         WcosEscalationRecord[]    @relation("WcosEscalationActor")
  wcosAcknowledgedEscalations     WcosEscalationRecord[]    @relation("WcosEscalationAcknowledger")
  wcosResolvedEscalations         WcosEscalationRecord[]    @relation("WcosEscalationResolver")
  savedJobs                       SavedJob[]                @relation("UserSavedJobs")
  collectionRuns                  JobCollectionRun[]        @relation("CollectionRunTriggerer")

  @@map("users")
}

model Membership {
  id                 String           @id @default(uuid()) @db.Uuid
  organizationId     String           @db.Uuid
  userId             String           @db.Uuid
  role               Role             @default(CANDIDATE)
  status             MembershipStatus @default(ACTIVE)
  employeeId         String?          @map("employee_id") @db.VarChar(50)
  designationId      String?          @map("designation_id") @db.Uuid
  department         String?          @db.VarChar(100)
  team               String?          @db.VarChar(100)
  reportingManagerId String?          @map("reporting_manager_id") @db.Uuid
  isTeamLead         Boolean          @default(false) @map("is_team_lead")
  teamLeadOf         String?          @map("team_lead_of") @db.VarChar(100)
  employmentType     String?          @map("employment_type") @db.VarChar(50)
  joiningDate        DateTime?        @map("joining_date") @db.Timestamptz(6)
  workLocation       String?          @map("work_location") @db.VarChar(100)
  workMode           String?          @map("work_mode") @db.VarChar(50)
  phone              String?          @db.VarChar(50)
  personalEmail      String?          @map("personal_email") @db.VarChar(255)
  activatedAt        DateTime?        @map("activated_at") @db.Timestamptz(6)
  createdAt          DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime         @updatedAt @db.Timestamptz(6)

  organization          Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  designation           Designation?           @relation(fields: [designationId], references: [id], onDelete: SetNull)
  reportingManager      User?                  @relation("ReportingManager", fields: [reportingManagerId], references: [id], onDelete: SetNull)
  staffActivationTokens StaffActivationToken[]

  @@unique([organizationId, userId], name: "org_user_unique")
  @@unique([organizationId, employeeId], name: "org_employee_id_unique")
  @@index([userId, status])
  @@index([organizationId, role, status])
  @@index([organizationId, designationId])
  @@index([organizationId, isTeamLead])
  @@index([reportingManagerId])
  @@map("memberships")
}

model Designation {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String            @map("organization_id") @db.Uuid
  name           String            @db.VarChar(100)
  code           String?           @db.VarChar(50)
  description    String?           @db.Text
  status         DesignationStatus @default(ACTIVE) @map("status")
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  memberships  Membership[]

  @@unique([organizationId, name], name: "org_designation_name_unique")
  @@index([organizationId, status], name: "idx_designations_org_status")
  @@map("designations")
}

model StaffActivationToken {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  membershipId   String    @map("membership_id") @db.Uuid
  tokenHash      String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(6)
  reservedUntil  DateTime? @map("reserved_until") @db.Timestamptz(6)
  usedAt         DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  membership   Membership   @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@index([membershipId, expiresAt], name: "idx_staff_tokens_membership_expires")
  @@index([organizationId], name: "idx_staff_tokens_organization")
  @@map("staff_activation_tokens")
}

model Candidate {
  id                 String             @id @default(uuid()) @db.Uuid
  organizationId     String             @db.Uuid
  userId             String             @unique @db.Uuid
  assignedEmployeeId String?            @db.Uuid
  status             CandidateStatus    @default(ONBOARDING)
  verificationStatus VerificationStatus @default(UNVERIFIED)

  // Contact & Location (V1 PRD §18)
  phone        String? @db.VarChar(50)
  city         String? @db.VarChar(100)
  state        String? @db.VarChar(100)
  country      String  @default("US") @db.VarChar(100)
  postalCode   String? @db.VarChar(20)
  timezone     String? @db.VarChar(50)
  linkedinUrl  String? @db.VarChar(500)
  githubUrl    String? @db.VarChar(500)
  portfolioUrl String? @db.VarChar(500)

  // Professional Summary (V1 PRD §18)
  headline             String?  @db.VarChar(255)
  professionalSummary  String?  @db.Text
  totalYearsExperience Decimal? @db.Decimal(4, 1)

  // Work Authorization (V1 PRD §18)
  workAuthorization   WorkAuthorizationStatus @default(CITIZEN)
  requiresSponsorship Boolean                 @default(false)
  visaDetails         String?                 @db.VarChar(255)

  // Preferences & Compensation Expectations (V1 PRD §18)
  targetRoles                  String[]                     @default([])
  targetLocations              String[]                     @default([])
  remotePreference             RemotePreference             @default(FLEXIBLE)
  desiredSalaryMin             Int?
  desiredSalaryMax             Int?
  salaryCurrency               String                       @default("USD") @db.VarChar(10)
  applicationAuthorizationMode ApplicationAuthorizationMode @default(MANAGED) @map("application_authorization_mode")

  // Operational & Verification Tracking (V1 PRD §17, §18)
  verifiedAt        DateTime? @db.Timestamptz(6)
  verifiedBy        String?   @db.Uuid
  verificationNotes String?   @db.Text

  // Timestamps
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  // Relationships
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedEmployee User?        @relation("AssignedCandidateEmployee", fields: [assignedEmployeeId], references: [id], onDelete: SetNull)
  verifier         User?        @relation("CandidateVerifier", fields: [verifiedBy], references: [id], onDelete: SetNull)

  experiences      CandidateExperience[]
  educations       CandidateEducation[]
  skills           CandidateSkill[]
  projects         CandidateProject[]
  certifications   CandidateCertification[]
  documents        CandidateDocument[]
  applications     Application[]
  jobOpportunities CandidateJobOpportunity[]
  ownedPrivateJobs Job[]                        @relation("PrivateJobOwner")
  tasks            Task[]
  conversations    Conversation[]
  internalNotes    InternalNote[]
  privacyRequests  PrivacyRequest[]
  intelligenceRuns ApplicationIntelligenceRun[]
  factAttestations CandidateFactAttestation[]
  documentExtracts CandidateDocumentExtract[]
  resumeReviews    ResumeReview[]
  jobMatches       CandidateJobMatch[]
  interviews       Interview[]
  offers           Offer[]
  offerDecisions   OfferDecision[]
  joiningRecords   JoiningRecord[]
  placementRecords PlacementRecord[]
  offerEvidence    OfferEvidence[]

  // Phase 10 CBOS Candidate Relations
  primaryCustomerAccounts        CustomerAccount[]               @relation("CustomerPrimaryCandidate")
  customerCandidateRelationships CustomerCandidateRelationship[] @relation("CandidateCustomerRelationships")
  serviceContracts               ServiceContract[]               @relation("CandidateServiceContracts")
  serviceEntitlements            ServiceEntitlement[]            @relation("CandidateEntitlements")
  commercialEvents               CommercialEvent[]               @relation("CandidateCommercialEvents")
  invoiceLines                   InvoiceLine[]                   @relation("CandidateInvoiceLines")
  revenueAttributions            RevenueAttribution[]            @relation("CandidateRevenueAttributions")

  // Phase 10H WCOS Candidate Relations
  wcosWorkItems WcosWorkItem[] @relation("WcosContinuityCandidate")

  @@index([organizationId, status])
  @@index([assignedEmployeeId, status])
  @@index([verificationStatus])
  @@map("candidates")
}

