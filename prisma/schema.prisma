  @@index([conversationId, createdAt(sort: Asc)], name: "idx_messages_conversation_created")
  @@index([conversationId, readAt], name: "idx_messages_conversation_unread")
  @@map("messages")
}

model InternalNote {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
