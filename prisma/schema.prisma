  EMPLOYEE_INVITATION_RESENT
  EMPLOYEE_DESIGNATION_CHANGED
  EMPLOYEE_DEPARTMENT_CHANGED
  EMPLOYEE_TEAM_CHANGED
  EMPLOYEE_MANAGER_CHANGED
