  isConfigured         Boolean               @default(true)
  rateLimitPerMinute   Int                   @default(60)
  rateLimitDaily       Int                   @default(5000)
  lastRunAt            DateTime?             @db.Timestamptz(6)
  lastSuccessAt        DateTime?             @db.Timestamptz(6)
  consecutiveFailures  Int                   @default(0)
  statusMessage        String?               @db.VarChar(512)
  documentation        Json?                 @db.JsonB
  createdAt            DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime              @default(now()) @updatedAt @db.Timestamptz(6)

  @@map("job_provider_configs")
}

model SavedJob {
  id                   String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId               String                @db.Uuid
  discoveredJobId      String                @db.Uuid
  notes                String?               @db.Text
  savedAt              DateTime              @default(now()) @db.Timestamptz(6)

  user                 User                  @relation("UserSavedJobs", fields: [userId], references: [id], onDelete: Cascade)
  discoveredJob        DiscoveredJob         @relation(fields: [discoveredJobId], references: [id], onDelete: Cascade)

  @@unique([userId, discoveredJobId])
  @@index([userId])
  @@index([discoveredJobId])
  @@map("saved_jobs")
}

