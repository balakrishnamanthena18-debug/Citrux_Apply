model DiscoveredJob {
  id                   String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  providerId           String                @db.VarChar(64)
  externalId           String                @db.VarChar(255)
  title                String                @db.VarChar(255)
  normalizedTitle      String                @db.VarChar(255)
  companyName          String                @db.VarChar(255)
  normalizedCompany    String                @db.VarChar(255)
  jobDescription       String                @db.Text
  requiredSkills       String[]              @default([])
  preferredSkills      String[]              @default([])
  industry             String?               @db.VarChar(64)
  employmentType       JobEmploymentType     @default(FULL_TIME)
  seniorityLevel       String?               @db.VarChar(32)
  experienceMin        Int?
  experienceMax        Int?
  salaryMin            Int?
  salaryMax            Int?
  salaryCurrency       String?               @default("USD") @db.VarChar(10)
  salaryPeriod         String?               @default("YEARLY") @db.VarChar(20)
  country              String?               @db.VarChar(10)
  state                String?               @db.VarChar(100)
  city                 String?               @db.VarChar(100)
  workArrangement      JobWorkArrangement    @default(UNSPECIFIED)
  postedAt             DateTime?             @db.Timestamptz(6)
  closingDate          DateTime?             @db.Timestamptz(6)
  lastSeenAt           DateTime              @default(now()) @db.Timestamptz(6)
  firstCollectedAt     DateTime              @default(now()) @db.Timestamptz(6)
  lastCheckedAt        DateTime              @default(now()) @db.Timestamptz(6)
  externalUrl          String                @db.VarChar(2048)
  canonicalUrl         String                @db.VarChar(2048)
  sourceAttribution    String                @db.VarChar(255)
  verificationStatus   JobVerificationStatus @default(NEWLY_DISCOVERED)
  availabilityStatus   JobStatus             @default(OPEN)
  contentFingerprint   String                @db.VarChar(64)
  duplicateGroupId     String?               @db.VarChar(64)
  isDuplicate          Boolean               @default(false)
  duplicateReason      String?               @db.VarChar(255)
  qualityScore         Float                 @default(100.0)
  rawMetadata          Json?                 @db.JsonB
  promotedToJobId      String?               @db.Uuid
  promotedToJob        Job?                  @relation("DiscoveredJobPromotion", fields: [promotedToJobId], references: [id], onDelete: SetNull)
  savedByUsers         SavedJob[]
  createdAt            DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime              @default(now()) @updatedAt @db.Timestamptz(6)

  @@unique([providerId, externalId])
  @@index([canonicalUrl])
  @@index([contentFingerprint])
  @@index([verificationStatus, availabilityStatus])
  @@index([country, workArrangement])
  @@index([industry, seniorityLevel])
  @@index([postedAt])
  @@index([promotedToJobId])
  @@map("discovered_jobs")
}

