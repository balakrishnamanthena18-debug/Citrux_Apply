}

/// Phase 6C — V1 outcome provenance (IMPORTED/EXTERNAL_VERIFIED/SYSTEM_DERIVED out of V1).
enum ApplicationOutcomeProvenance {
  EMPLOYEE_RECORDED
  CANDIDATE_REPORTED
  STAFF_VERIFIED
}

/// Phase 6C — append-only correction state (void-only; no hard delete).
enum ApplicationOutcomeCorrectionState {
  ACTIVE
  VOIDED
  SUPERSEDED
}

enum TaskCategory {
  CANDIDATE
  JOB
  APPLICATION
  QA
  OPERATIONAL
}

enum TaskType {
