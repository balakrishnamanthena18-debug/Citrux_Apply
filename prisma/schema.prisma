  requestedBy  User         @relation("PrivacyRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  verifiedBy   User?        @relation("PrivacyVerifiedBy", fields: [verifiedById], references: [id], onDelete: Restrict)
  completedBy  User?        @relation("PrivacyCompletedBy", fields: [completedById], references: [id], onDelete: Restrict)

  @@index([organizationId, status], name: "idx_privacy_requests_org_status")
  @@index([organizationId, candidateId], name: "idx_privacy_requests_org_candidate")
  @@index([organizationId, createdAt], name: "idx_privacy_requests_org_created")
  @@map("privacy_requests")
}

model RateLimitBucket {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  keyHash      String    @unique @map("key_hash") @db.VarChar(64)
  action       String    @map("action") @db.VarChar(50)
  windowStart  DateTime  @map("window_start") @db.Timestamptz(6)
  attemptCount Int       @default(0) @map("attempt_count")
  lockedUntil  DateTime? @map("locked_until") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([action], name: "idx_rate_limit_buckets_action")
  @@index([lockedUntil], name: "idx_rate_limit_buckets_locked_until")
  @@index([windowStart], name: "idx_rate_limit_buckets_window_start")
  @@map("rate_limit_buckets")
}

// ==========================================
// Phase 2 — Application Intelligence foundation
// Contracts + persistence only. No AI execution.
// ==========================================

/// Provenance of a candidate fact referenced by intelligence.
/// AI_INFERRED must never become canonical Candidate truth automatically.
enum FactProvenance {
  VERIFIED
  CANDIDATE_PROVIDED
  EMPLOYEE_PROVIDED
  AI_INFERRED
  UNKNOWN
}

enum IntelligenceRunStatus {
  QUEUED
  RUNNING
  RETRY_PENDING
  SUCCEEDED
  FAILED
}

enum IntelligenceResultFreshness {
  CURRENT
  STALE
  RECOMPUTE_REQUIRED
}

enum IntelligenceValidationStatus {
  PENDING
  PASSED
  FAILED
  SKIPPED
}

/// Immutable JD capture. Analyses must pin to a snapshot, never live Job.jobDescription alone.
model JobDescriptionSnapshot {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String   @db.Uuid
  jobId           String   @db.Uuid
  sourceText      String   @db.Text
  contentHash     String   @db.VarChar(64)
  sourceUrl       String?  @db.VarChar(1024)
  sourceLabel     String?  @db.VarChar(100)
  sourceVersionId String   @db.VarChar(128)
  capturedAt      DateTime @default(now()) @db.Timestamptz(6)
  capturedById    String?  @db.Uuid

  organization     Organization                 @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  job              Job                          @relation(fields: [jobId], references: [id], onDelete: Restrict)
  requirementSets  JobRequirementSet[]
  intelligenceRuns ApplicationIntelligenceRun[]
  jobMatches       CandidateJobMatch[]

  @@unique([jobId, contentHash])
  @@index([organizationId, jobId])
  @@index([jobId, capturedAt])
  @@map("job_description_snapshots")
}

/// Structured requirements container bound to an exact JD snapshot.
/// Never floats independently of its source snapshot. Content is append-only;
/// freshness may be marked STALE/RECOMPUTE_REQUIRED when a newer snapshot exists.
model JobRequirementSet {
  id                   String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId       String                      @db.Uuid
  jobId                String                      @db.Uuid
  snapshotId           String                      @db.Uuid
  schemaVersion        String                      @db.VarChar(32)
  extractionVersion    String                      @db.VarChar(32)
  normalizationVersion String                      @db.VarChar(32)
  freshness            IntelligenceResultFreshness @default(CURRENT)
  /// JSON array of structured requirements (see requirements-contract).
  requirements         Json                        @default("[]") @db.JsonB
  createdAt            DateTime                    @default(now()) @db.Timestamptz(6)

  organization     Organization                 @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  job              Job                          @relation(fields: [jobId], references: [id], onDelete: Restrict)
  snapshot         JobDescriptionSnapshot       @relation(fields: [snapshotId], references: [id], onDelete: Restrict)
  intelligenceRuns ApplicationIntelligenceRun[]
  jobMatches       CandidateJobMatch[]

  @@index([organizationId, jobId])
  @@index([snapshotId])
  @@index([jobId, freshness])
  @@map("job_requirement_sets")
}

/// Traceable intelligence analysis request/execution record.
model ApplicationIntelligenceRun {
  id                String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId    String                       @db.Uuid
  /// Optional: job-only analyses (e.g. JOB_REQUIREMENT_EXTRACTION) omit candidate/application.
  candidateId       String?                      @db.Uuid
  applicationId     String?                      @db.Uuid
  jobId             String                       @db.Uuid
  snapshotId        String                       @db.Uuid
  requirementSetId  String?                      @db.Uuid
  requestedById     String?                      @db.Uuid
  /// e.g. JOB_REQUIREMENT_EXTRACTION | APPLICATION_INTELLIGENCE
  analysisPurpose   String                       @default("APPLICATION_INTELLIGENCE") @db.VarChar(64)
  status            IntelligenceRunStatus        @default(QUEUED)
  freshness         IntelligenceResultFreshness  @default(CURRENT)
  validationStatus  IntelligenceValidationStatus @default(PENDING)
  provider          String                       @db.VarChar(64)
  model             String                       @db.VarChar(128)
  promptVersion     String                       @db.VarChar(64)
  schemaVersion     String                       @db.VarChar(64)
  scoringVersion    String                       @db.VarChar(64)
  idempotencyKey    String                       @db.VarChar(191)
  sourceDataVersion String                       @db.VarChar(256)
  attemptCount      Int                          @default(0)
  maxAttempts       Int                          @default(3)
  leaseExpiresAt    DateTime?                    @db.Timestamptz(6)
  /// Validated provider envelope only (Gate 4). Not Alignment/Readiness scoring.
  validatedPayload  Json?                        @db.JsonB
  providerRequestId String?                      @db.VarChar(128)
  errorCode         String?                      @db.VarChar(64)
  errorMessage      String?                      @db.Text
  createdAt         DateTime                     @default(now()) @db.Timestamptz(6)
  startedAt         DateTime?                    @db.Timestamptz(6)
  completedAt       DateTime?                    @db.Timestamptz(6)

  organization    Organization                @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  candidate       Candidate?                  @relation(fields: [candidateId], references: [id], onDelete: Restrict)
  application     Application?                @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  job             Job                         @relation(fields: [jobId], references: [id], onDelete: Restrict)
  snapshot        JobDescriptionSnapshot      @relation(fields: [snapshotId], references: [id], onDelete: Restrict)
  requirementSet  JobRequirementSet?          @relation(fields: [requirementSetId], references: [id], onDelete: SetNull)
  requestedBy     User?                       @relation("IntelligenceRunRequester", fields: [requestedById], references: [id], onDelete: SetNull)
  alignmentResult ApplicationAlignmentResult?
  readinessResult ApplicationReadinessResult?

  @@unique([idempotencyKey])
  @@index([organizationId, applicationId, createdAt])
  @@index([candidateId, createdAt])
  @@index([status, createdAt])
  @@index([status, leaseExpiresAt])
  @@index([applicationId, freshness, status])
  @@index([analysisPurpose, jobId, createdAt])
  @@map("application_intelligence_runs")
}

model ApplicationAlignmentResult {
  id              String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String                      @db.Uuid
  applicationId   String                      @db.Uuid
  runId           String                      @unique @db.Uuid
  freshness       IntelligenceResultFreshness @default(CURRENT)
  scoringVersion  String                      @db.VarChar(64)
  overallScore    Int?
  dimensionScores Json                        @default("{}") @db.JsonB
  evidence        Json                        @default("[]") @db.JsonB
  createdAt       DateTime                    @default(now()) @db.Timestamptz(6)

  organization Organization               @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  application  Application                @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  run          ApplicationIntelligenceRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([organizationId, applicationId])
  @@index([applicationId, freshness])
  @@map("application_alignment_results")
}

model ApplicationReadinessResult {
  id             String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String                      @db.Uuid
  applicationId  String                      @db.Uuid
  runId          String                      @unique @db.Uuid
  freshness      IntelligenceResultFreshness @default(CURRENT)
  /// READY | READY_WITH_WARNINGS | REVIEW_REQUIRED | BLOCKED | UNKNOWN
  readinessState String                      @db.VarChar(32)
  blockers       Json                        @default("[]") @db.JsonB
  warnings       Json                        @default("[]") @db.JsonB
  nextActions    Json                        @default("[]") @db.JsonB
  evidence       Json                        @default("[]") @db.JsonB
  createdAt      DateTime                    @default(now()) @db.Timestamptz(6)

  organization Organization               @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  application  Application                @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  run          ApplicationIntelligenceRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([organizationId, applicationId])
  @@index([applicationId, freshness])
  @@map("application_readiness_results")
}

/// Sparse field-level provenance attestations (Design Lock Option B).
/// Default without a row: CANDIDATE_PROVIDED when the fact exists.
/// AI_INFERRED must never be stored here as canonical truth.
model CandidateFactAttestation {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String         @db.Uuid
  candidateId    String         @db.Uuid
  /// Career/entity type key, e.g. CandidateSkill | CandidateExperience | Candidate
  entityType     String         @db.VarChar(64)
  /// Entity row id; for Candidate-level fields use candidateId
  entityId       String         @db.Uuid
  /// Field name within entity, or "*" for entity-level attestation
  field          String         @db.VarChar(128)
  provenance     FactProvenance
  attestedById   String?        @db.Uuid
  attestedAt     DateTime       @default(now()) @db.Timestamptz(6)
  note           String?        @db.Text
  createdAt      DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime       @updatedAt @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  candidate    Candidate    @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  attestedBy   User?        @relation("FactAttestationAuthor", fields: [attestedById], references: [id], onDelete: SetNull)

  @@unique([candidateId, entityType, entityId, field])
  @@index([organizationId, candidateId])
  @@index([candidateId, entityType, entityId])
  @@map("candidate_fact_attestations")
}

// ==========================================
// PHASE 4: ATS & RESUME INTELLIGENCE
// Separate from Phase 2 alignment/readiness.
// CandidateDocument.id is the immutable resume version identity.
// ==========================================

enum ResumeParseStatus {
  SUCCESS
  EMPTY
  FAILED
  UNSUPPORTED
}

enum ResumeReviewStatus {
  QUEUED
  ANALYZING
  READY
  STALE
  FAILED
}

/// Server-side extraction of readable text from one immutable CandidateDocument.
/// extractedText is sensitive — never expose in normal candidate API payloads.
model CandidateDocumentExtract {
  id                  String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId      String            @db.Uuid
  candidateId         String            @db.Uuid
  candidateDocumentId String            @db.Uuid
  contentHash         String            @db.VarChar(64)
  extractedText       String            @db.Text
  parseStatus         ResumeParseStatus
  parserVersion       String            @db.VarChar(64)
  mimeType            String            @db.VarChar(100)
  pageCount           Int?
  charCount           Int               @default(0)
  errorCode           String?           @db.VarChar(64)
  parsedAt            DateTime          @db.Timestamptz(6)
  createdAt           DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime          @updatedAt @db.Timestamptz(6)

  organization      Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  candidate         Candidate         @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  candidateDocument CandidateDocument @relation(fields: [candidateDocumentId], references: [id], onDelete: Cascade)
  resumeReviews     ResumeReview[]

  @@unique([organizationId, candidateDocumentId, contentHash])
  @@index([candidateDocumentId])
  @@index([organizationId, candidateId])
  @@map("candidate_document_extracts")
}

/// Resume representation analysis (Resume ↔ Candidate Truth ↔ Job).
/// Distinct from ApplicationAlignmentResult (Candidate ↔ Job).
model ResumeReview {
  id                  String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId      String                      @db.Uuid
  candidateId         String                      @db.Uuid
  applicationId       String?
  candidateDocumentId String                      @db.Uuid
  /// Compatibility copy of CandidateDocument.versionNumber at request time.
  documentVersion     Int
  extractId           String?
  status              ResumeReviewStatus          @default(QUEUED)
  freshness           IntelligenceResultFreshness @default(CURRENT)
  analysisVersion     String                      @db.VarChar(64)
  /// Hash of extract + profile facts + requirement set (when application-bound).
  sourceDataVersion   String                      @db.VarChar(256)
  idempotencyKey      String                      @db.VarChar(191)
  attemptCount        Int                         @default(0)
  maxAttempts         Int                         @default(3)
  leaseExpiresAt      DateTime?                   @db.Timestamptz(6)
  atsReadability      Json                        @default("{}") @db.JsonB
  representation      Json                        @default("{}") @db.JsonB
  strengths           Json                        @default("[]") @db.JsonB
  recommendations     Json                        @default("[]") @db.JsonB
  overallLabel        String?                     @db.VarChar(64)
  overallSummary      String?                     @db.Text
  errorCode           String?                     @db.VarChar(64)
  /// Sanitized human-safe message only — never parser/stack dumps.
  errorMessage        String?                     @db.Text
  requestedById       String?
  createdAt           DateTime                    @default(now()) @db.Timestamptz(6)
  startedAt           DateTime?                   @db.Timestamptz(6)
  completedAt         DateTime?                   @db.Timestamptz(6)

  organization      Organization              @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  candidate         Candidate                 @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  application       Application?              @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  candidateDocument CandidateDocument         @relation(fields: [candidateDocumentId], references: [id], onDelete: Cascade)
  extract           CandidateDocumentExtract? @relation(fields: [extractId], references: [id], onDelete: SetNull)
  requestedBy       User?                     @relation("ResumeReviewRequester", fields: [requestedById], references: [id], onDelete: SetNull)

  @@unique([idempotencyKey])
  @@index([organizationId, applicationId, createdAt])
  @@index([candidateId, createdAt])
  @@index([status, leaseExpiresAt])
  @@index([applicationId, freshness, status])
  @@index([candidateDocumentId, createdAt])
  @@map("resume_reviews")
}

/// Phase 5 — deterministic candidate↔job match recommendation (pre-application).
/// Distinct from ApplicationAlignmentResult. ONE CURRENT row per org+candidate+job.
enum CandidateJobMatchStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  STALE
  FAILED
}

enum CandidateJobMatchCategory {
  STRONG_MATCH
  GOOD_MATCH
  POSSIBLE_MATCH
  NEEDS_REVIEW
  LOW_MATCH
}

model CandidateJobMatch {
  id                      String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId          String                      @db.Uuid
  candidateId             String                      @db.Uuid
  jobId                   String                      @db.Uuid
  snapshotId              String?                     @db.Uuid
  requirementSetId        String?                     @db.Uuid
  matchingContractVersion String                      @db.VarChar(64)
  sourceDataVersion       String                      @db.VarChar(256)
  status                  CandidateJobMatchStatus     @default(QUEUED)
  freshness               IntelligenceResultFreshness @default(CURRENT)
  category                CandidateJobMatchCategory?
  /// Candidate-safe qualification dimension summaries (no raw requirement dumps).
  qualificationSummary    Json                        @default("[]") @db.JsonB
  /// Candidate-safe preference dimension summaries.
  preferenceSummary       Json                        @default("[]") @db.JsonB
  /// Human presentation: why / strengths / thingsToCheck / preferences.
  presentation            Json                        @default("{}") @db.JsonB
  /// Structured evidence refs only — never resume/JD dumps.
  evidenceRefs            Json                        @default("[]") @db.JsonB
  errorCode               String?                     @db.VarChar(64)
  /// Human-safe only — never JD/resume/requirement dumps or secrets.
  errorMessage            String?                     @db.Text
  /// Evaluation-request identity (org+candidate+job+contract+sourceDataVersion).
  /// Resolves to the single CURRENT match row — does not create a second feed row.
  idempotencyKey          String                      @db.VarChar(191)
  attemptCount            Int                         @default(0)
  maxAttempts             Int                         @default(3)
  leaseExpiresAt          DateTime?                   @db.Timestamptz(6)
  savedAt                 DateTime?                   @db.Timestamptz(6)
  dismissedAt             DateTime?                   @db.Timestamptz(6)
  dismissReason           String?                     @db.VarChar(64)
  applicationRequestedAt  DateTime?                   @db.Timestamptz(6)
  opportunityId           String?                     @db.Uuid
  /// Audit/context only — never an authorization source.
  requestedById           String?                     @db.Uuid
  createdAt               DateTime                    @default(now()) @db.Timestamptz(6)
  evaluatedAt             DateTime?                   @db.Timestamptz(6)
  updatedAt               DateTime                    @updatedAt @db.Timestamptz(6)

  organization   Organization             @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  candidate      Candidate                @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  job            Job                      @relation(fields: [jobId], references: [id], onDelete: Restrict)
  snapshot       JobDescriptionSnapshot?  @relation(fields: [snapshotId], references: [id], onDelete: SetNull)
  requirementSet JobRequirementSet?       @relation(fields: [requirementSetId], references: [id], onDelete: SetNull)
  opportunity    CandidateJobOpportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  requestedBy    User?                    @relation("JobMatchRequester", fields: [requestedById], references: [id], onDelete: SetNull)

  @@unique([organizationId, candidateId, jobId])
  @@unique([idempotencyKey])
  @@index([candidateId, status, freshness, dismissedAt])
  @@index([organizationId, jobId])
  @@index([status, leaseExpiresAt])
  @@map("candidate_job_matches")
}

