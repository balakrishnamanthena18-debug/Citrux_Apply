# Node Environment
NODE_ENV=development

# Database (Supabase PostgreSQL with TLS enforced)
# Runtime pooled queries via PgBouncer / Supavisor (Port 6543)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# CLI direct connection for migrations (Session Pooler Port 5432 with IPv4 support)
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@[REGION].pooler.supabase.com:5432/postgres"

# Supabase Public Configuration (Safe for client-side bundle)
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.[ANON_TOKEN_PAYLOAD].[SIGNATURE]"

# Canonical Application URL
# Local development: "http://localhost:3000"
# Production hosting (e.g. Vercel): "https://portal.careerbutton.in" (HTTPS required; localhost rejected)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Optional server-only canonical override (takes precedence on server over NEXT_PUBLIC_APP_URL):
# APP_URL="https://portal.careerbutton.in"
# Private storage buckets (create manually if missing; public=false):
# - candidate-documents
# - submission-evidence
# - outcome-evidence (Phase 6C O5)

# Supabase Server-Only Privileged Service Role Key (NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.[SERVICE_ROLE_PAYLOAD].[SIGNATURE]"

# Vercel Cron Secret (Server-Only)
CRON_SECRET="your-secure-random-cron-secret-32-chars-min"

# Operating Organization (UUID for default operating tenant in V1)
OPERATING_ORGANIZATION_ID="00000000-0000-0000-0000-000000000001"

# SMTP Email Configuration (Server-Only) — used by OOS Nodemailer application emails
# AND by scripts/apply-supabase-auth-smtp.ts to configure Mumbai Supabase Auth custom SMTP.
# Never expose via NEXT_PUBLIC_*. Prefer Gmail App Password (not account password).
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="notifications@example.com"
SMTP_PASS="your-smtp-app-password"
EMAIL_FROM="notifications@example.com"

# Optional: Supabase Management API token (Owner/Admin) for Auth SMTP + template apply.
# Create at https://supabase.com/dashboard/account/tokens — never commit this value.
# SUPABASE_ACCESS_TOKEN="sbp_..."
# SUPABASE_PROJECT_REF="vgrvijugljzlpohsbmjg"

# Phase 2 Application Intelligence — experimental NVIDIA NIM (server-only).
# Never use NEXT_PUBLIC_*. Never commit real keys. Optional until provider adapter is registered.
NVIDIA_API_KEY="nvapi-your-nvidia-nim-api-key"
NVIDIA_API_BASE_URL="https://integrate.api.nvidia.com/v1"

# Global Job Discovery Engine — FreeHire API Key (https://freehire.me/my/api-keys)
FREEHIRE_API_KEY="fhk_your-freehire-api-key"